// A Vitra app: a web frontend in a native window, and Go commands it may call.
//
//	vitra dev                              # run with the inspector enabled
//	CGO_ENABLED=1 go run -tags vitra_native .
//
// The frontend is untrusted. It can call a command only if a grant names the
// window, its origin, and the command's permission. This starter grants one
// command, greet, to the main window.
[[- if .Plugins]] It also uses the official [[.PluginList]]
// plugins, each granted as narrowly as a starter can.
[[- end]]
package main

import (
	"context"
	"embed"
	"fmt"
	"io/fs"
	"os"
[[- if .FS]]
	"path/filepath"
[[- end]]
	"runtime"
	"strings"

	"go.klarlabs.de/vitra"
	"go.klarlabs.de/vitra/app"
[[- if .Plugins]]
	"go.klarlabs.de/vitra/desktop"
[[- end]]
	"go.klarlabs.de/vitra/domain"
	"go.klarlabs.de/vitra/platform/darwin"
	"go.klarlabs.de/vitra/platform/linux"
	"go.klarlabs.de/vitra/platform/windows"
[[- if .Plugins]]
	"go.klarlabs.de/vitra/plugin/official"
[[- end]]
)

const appID = "com.example.app"

//go:embed [[.Embed]]
var frontendRoot embed.FS

// GreetRequest is the input of the greet command. The frontend's JSON is
// decoded into it strictly: unknown fields are an error.
type GreetRequest struct {
	Name string `json:"name"`
}

// Greeting is the result of the greet command.
type Greeting struct {
	Message string `json:"message"`
}
[[- if .FS]]

// DataDirRequest is the (empty) input of the dataDir command.
type DataDirRequest struct{}

// DataDir is the result of the dataDir command: the one folder the page may
// read and write.
type DataDir struct {
	Path string `json:"path"`
}
[[- end]]

func main() {
	if err := run(); err != nil {
		fmt.Fprintln(os.Stderr, "app:", err)
		os.Exit(1)
	}
}

func run() error {
	rt, err := vitra.New(vitra.Config{AppID: appID})
	if err != nil {
		return err
	}

	// An explicit, typed command. `vitra generate typescript --app .`
	// writes a matching client to frontend/vitra-client.ts.
	if err := vitra.Register(rt, vitra.Command[GreetRequest, Greeting]{
		Name:        "greet",
		Description: "Greet someone by name",
		Permission:  "greet",
		Handler: func(_ context.Context, inv domain.Invocation, req GreetRequest) (Greeting, error) {
			name := strings.TrimSpace(req.Name)
			if name == "" {
				name = "world"
			}
			return Greeting{Message: fmt.Sprintf("Hello, %s! (from Go, called by window %q)", name, inv.Caller.Window)}, nil
		},
	}); err != nil {
		return err
	}
[[- if .FS]]

	// The app's data folder. fs.read and fs.write are scoped to it below, so
	// the page cannot touch any other file; dataDir tells the page where it is.
	dataDir, err := appDataDir()
	if err != nil {
		return err
	}
	if err := vitra.Register(rt, vitra.Command[DataDirRequest, DataDir]{
		Name:        "dataDir",
		Description: "The folder the page may read and write",
		Permission:  "dataDir",
		Handler: func(context.Context, domain.Invocation, DataDirRequest) (DataDir, error) {
			return DataDir{Path: dataDir}, nil
		},
	}); err != nil {
		return err
	}
	inDataDir := &domain.PathScope{Allow: []string{dataDir + "/**"}}
[[- end]]
[[- if .Plugins]]

	// The grant: the main window, showing the app's own assets, may call
	// greet and the plugin permissions below. Nothing else is allowed.
	grant, err := domain.NewCapabilityGrant(
		"main-window", "what the main window may do",
		[]domain.WindowID{"main"},
		[]domain.Origin{domain.OriginPackagedLocal},
		[]domain.PermissionSpec{
			{Name: "greet"},
[[- if .FS]]
			// fs: read and write inside the data folder only. To narrow
			// writes further, for example to Markdown notes, scope fs.write
			// to dataDir + "/**/*.md". Never grant path.open on a folder the
			// page can write: it could drop a program there and launch it.
			{Name: "dataDir"},
			{Name: desktop.PermFSRead, PathScope: inDataDir},
			{Name: desktop.PermFSWrite, PathScope: inDataDir},
[[- end]]
[[- if .Dialog]]
			// dialog: the open and save pickers only. A picked path is not a
			// grant: reading or writing it still needs a scoped fs permission.
			{Name: desktop.PermDialogOpen},
			{Name: desktop.PermDialogSave},
[[- end]]
[[- if .Clipboard]]
			// clipboard: write only. Reading would show the page whatever the
			// user copied in other apps; add desktop.PermClipboardRead only
			// if a feature needs it.
			{Name: desktop.PermClipboardWrite},
[[- end]]
[[- if .Notification]]
			// notification: show desktop notifications.
			{Name: desktop.PermNotificationShow},
[[- end]]
[[- if .OS]]
			// os: read-only platform facts (OS, architecture, locale).
			{Name: desktop.PermOsInfo},
[[- end]]
		},
	)
[[- else]]

	// The grant: the main window, showing the app's own assets, may call
	// greet. Nothing else is allowed. For files, dialogs, the clipboard, and
	// more, call a.UseOfficialPlugins(ctx) after app.New and grant the
	// permissions you need the same way.
	grant, err := domain.NewCapabilityGrant(
		"main-window", "what the main window may do",
		[]domain.WindowID{"main"},
		[]domain.Origin{domain.OriginPackagedLocal},
		[]domain.PermissionSpec{{Name: "greet"}},
	)
[[- end]]
	if err != nil {
		return err
	}
	if err := rt.RegisterGrant(grant); err != nil {
		return err
	}

	assets, err := fs.Sub(frontendRoot, "[[.Root]]")
	if err != nil {
		return err
	}
	a, err := app.New(app.Options{
		AppID:   appID,
		Title:   "Vitra App",
		Assets:  assets,
		Host:    newHost(),
		Runtime: rt,
		Window:  app.WindowOptions{ID: "main", Width: 900, Height: 640},
	})
	if err != nil {
		return err
	}
[[- if .Plugins]]
	// Only these official plugins. UseOfficialPlugins grants nothing: the
	// grant above decides what the page may call.
	if err := a.UseOfficialPlugins(context.Background(), [[.PluginCalls]]); err != nil {
		return err
	}
[[- end]]
	return a.Run(context.Background())
}

// newHost returns this OS's native host (a stub without -tags vitra_native).
func newHost() app.DesktopHost {
	switch runtime.GOOS {
	case "darwin":
		return darwin.New()
	case "windows":
		return windows.New()
	default:
		return linux.New()
	}
}
[[- if .FS]]

// appDataDir creates the app's per-user data folder (under the home
// directory) and returns it with symlinks resolved, in slash form: path
// scopes compare strings, so the grant must name the real location.
func appDataDir() (string, error) {
	base, err := os.UserConfigDir()
	if err != nil {
		return "", err
	}
	dir := filepath.Join(base, appID)
	if err := os.MkdirAll(dir, 0o700); err != nil {
		return "", err
	}
	real, err := filepath.EvalSymlinks(dir)
	if err != nil {
		return "", err
	}
	return filepath.ToSlash(real), nil
}
[[- end]]
