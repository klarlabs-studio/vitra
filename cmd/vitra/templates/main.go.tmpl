// A Vitra app: a web frontend in a native window, and Go commands it may call.
//
//	vitra dev                              # run with the inspector enabled
//	CGO_ENABLED=1 go run -tags vitra_native .
//
// The frontend is untrusted. It can call a command only if a grant names the
// window, its origin, and the command's permission. This starter grants one
// command, greet, to the main window.
package main

import (
	"context"
	"embed"
	"fmt"
	"io/fs"
	"os"
	"runtime"
	"strings"

	"go.klarlabs.de/vitra"
	"go.klarlabs.de/vitra/app"
	"go.klarlabs.de/vitra/domain"
	"go.klarlabs.de/vitra/platform/darwin"
	"go.klarlabs.de/vitra/platform/linux"
	"go.klarlabs.de/vitra/platform/windows"
)

const appID = "com.example.app"

//go:embed __VITRA_EMBED__
var frontendRoot embed.FS

// GreetRequest is the input of the greet command. The frontend's JSON is
// decoded into it strictly: unknown fields are an error.
type GreetRequest struct {
	Name string `json:"name"`
}

// Greeting is the result of the greet command.
type Greeting struct {
	Message string `json:"message"`
}

func main() {
	if err := run(); err != nil {
		fmt.Fprintln(os.Stderr, "app:", err)
		os.Exit(1)
	}
}

func run() error {
	rt, err := vitra.New(vitra.Config{AppID: appID})
	if err != nil {
		return err
	}

	// An explicit, typed command. `vitra generate typescript --app .`
	// writes a matching client to frontend/vitra-client.ts.
	if err := vitra.Register(rt, vitra.Command[GreetRequest, Greeting]{
		Name:        "greet",
		Description: "Greet someone by name",
		Permission:  "greet",
		Handler: func(_ context.Context, inv domain.Invocation, req GreetRequest) (Greeting, error) {
			name := strings.TrimSpace(req.Name)
			if name == "" {
				name = "world"
			}
			return Greeting{Message: fmt.Sprintf("Hello, %s! (from Go, called by window %q)", name, inv.Caller.Window)}, nil
		},
	}); err != nil {
		return err
	}

	// The grant: the main window, showing the app's own assets, may call
	// greet. Nothing else is allowed. To use files, dialogs, the clipboard,
	// and more, register the official plugins (plugin/official) and grant
	// their permissions the same way; see example/competitive in the Vitra
	// repository.
	grant, err := domain.NewCapabilityGrant(
		"main-window", "what the main window may do",
		[]domain.WindowID{"main"},
		[]domain.Origin{domain.OriginPackagedLocal},
		[]domain.PermissionSpec{{Name: "greet"}},
	)
	if err != nil {
		return err
	}
	if err := rt.RegisterGrant(grant); err != nil {
		return err
	}

	assets, err := fs.Sub(frontendRoot, "__VITRA_ROOT__")
	if err != nil {
		return err
	}
	a, err := app.New(app.Options{
		AppID:   appID,
		Title:   "Vitra App",
		Assets:  assets,
		Host:    newHost(),
		Runtime: rt,
		Window:  app.WindowOptions{ID: "main", Width: 900, Height: 640},
	})
	if err != nil {
		return err
	}
	return a.Run(context.Background())
}

// newHost returns this OS's native host (a stub without -tags vitra_native).
func newHost() app.DesktopHost {
	switch runtime.GOOS {
	case "darwin":
		return darwin.New()
	case "windows":
		return windows.New()
	default:
		return linux.New()
	}
}
